{
  "compilerOptions": {
    /* Language & Environment */
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2020"
    ],
    /* Module Resolution */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    /* Type Checking */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    /* Emit */
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": [
    "index.ts",
    "app.ts",
    "config/**/*.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
